# Maaya World HRMS - Environment Template
# Copy this file to .env and fill in your values. Never commit .env to version control.

# Database (PostgreSQL)
DB_URL=jdbc:postgresql://127.0.0.1:5432/hrms_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Server & Security
PORT=8083
HRMS_AUTH_SECRET=change-this-to-a-secure-random-token
HRMS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Zoho ZeptoMail (Transactional Email)
ZEPTOMAIL_URL=https://api.zeptomail.in/v1.1/email
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_FROM_NAME=Maaya World
ZEPTOMAIL_FROM_EMAIL=noreply@themaayaworld.com
ZEPTOMAIL_BOUNCE_ADDRESS=bounce@themaayaworld.com

# Portal URLs & Branding
HRMS_PORTAL_URL=http://localhost:5173/login
HRMS_LOGO_URL=https://raw.githubusercontent.com/maayaworldtech-droid/Hrms/main/src/assets/logo-new.png

